# Dev: hit THREDDS/xcube directly on localhost, not the Cloudflare tunnel
# (both send Access-Control-Allow-Origin: *, so localhost origins already
# work with zero extra config). Swap to the tunnel URL only when testing
# from a different machine.
VITE_THREDDS_URL=http://localhost:8080
VITE_XCUBE_URL=http://localhost:8000
