# Copy this file to .env (gitignored) and fill in real values.
# Never commit real credentials.

EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Optional: where reproject.py's neighbor-info/lonlats disk caches live.
# Defaults to backend/data/cache if unset -- override if that drive is
# small (confirmed real: Tier B's neighbor-info cache alone can reach
# multi-GB per satellite, see reproject.py's _CACHE_DIR docstring).
GLOBAL_MOSAIC_CACHE_DIR=
